{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <p class="text-muted">{{ text_intro }}</p>
        <ul class="nav nav-tabs">
          <li class="nav-item"><a href="#tab-general" data-bs-toggle="tab" class="nav-link active">{{ text_tab_general }}</a></li>
          <li class="nav-item"><a href="#tab-order" data-bs-toggle="tab" class="nav-link">{{ text_tab_order }}</a></li>
          <li class="nav-item"><a href="#tab-status" data-bs-toggle="tab" class="nav-link">{{ text_tab_status }}</a></li>
          <li class="nav-item"><a href="#tab-customer" data-bs-toggle="tab" class="nav-link">{{ text_tab_customer }}</a></li>
          <li class="nav-item"><a href="#tab-otp" data-bs-toggle="tab" class="nav-link">{{ text_tab_otp }}</a></li>
          <li class="nav-item"><a href="#tab-send" data-bs-toggle="tab" class="nav-link">{{ text_tab_send }}</a></li>
          <li class="nav-item"><a href="#tab-log" data-bs-toggle="tab" class="nav-link">{{ text_tab_log }}</a></li>
        </ul>
        <div class="tab-content">
          <div id="tab-general" class="tab-pane active">
            <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
              <div class="row mb-3">
                <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="module_corbit_sms_status" value="0"/>
                    <input type="checkbox" name="module_corbit_sms_status" value="1" id="input-status" class="form-check-input"{% if module_corbit_sms_status %} checked{% endif %}/>
                  </div>
                </div>
              </div>
              <div class="row mb-3 required">
                <label for="input-api-key" class="col-sm-2 col-form-label">{{ entry_api_key }}</label>
                <div class="col-sm-10">
                  <input type="password" name="module_corbit_sms_api_key" value="{{ module_corbit_sms_api_key }}" placeholder="{{ entry_api_key }}" id="input-api-key" class="form-control" autocomplete="off"/>
                  <div id="error-api-key" class="invalid-feedback"></div>
                </div>
              </div>
              <div class="row mb-3 required">
                <label for="input-sender" class="col-sm-2 col-form-label">{{ entry_sender }}</label>
                <div class="col-sm-10">
                  <input type="text" name="module_corbit_sms_sender" value="{{ module_corbit_sms_sender }}" placeholder="{{ entry_sender }}" id="input-sender" class="form-control"/>
                  <div class="form-text">{{ help_sender }}</div>
                  <div id="error-sender" class="invalid-feedback"></div>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-admin-telephone" class="col-sm-2 col-form-label">{{ entry_admin_telephone }}</label>
                <div class="col-sm-10">
                  <input type="text" name="module_corbit_sms_admin_telephone" value="{{ module_corbit_sms_admin_telephone }}" placeholder="05xxxxxxxx" id="input-admin-telephone" class="form-control" dir="ltr"/>
                  <div class="form-text">{{ help_admin_telephone }}</div>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-test-telephone" class="col-sm-2 col-form-label">{{ entry_test_telephone }}</label>
                <div class="col-sm-10">
                  <div class="input-group">
                    <input type="text" value="" placeholder="05xxxxxxxx" id="input-test-telephone" class="form-control" dir="ltr"/>
                    <button type="button" id="button-test" class="btn btn-outline-primary"><i class="fa-solid fa-paper-plane"></i> {{ button_test }}</button>
                    <button type="button" id="button-balance" class="btn btn-outline-secondary"><i class="fa-solid fa-wallet"></i> {{ button_balance }}</button>
                  </div>
                </div>
              </div>

            </form>
          </div>
          <div id="tab-order" class="tab-pane">
            <div class="row mb-3">
              <label class="col-sm-2 col-form-label">{{ entry_order_customer }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch mb-2">
                  <input type="hidden" name="module_corbit_sms_order_customer_status" value="0" form="form-module"/>
                  <input type="checkbox" name="module_corbit_sms_order_customer_status" value="1" class="form-check-input" form="form-module"{% if module_corbit_sms_order_customer_status %} checked{% endif %}/>
                </div>
                <textarea name="module_corbit_sms_order_customer_text" rows="3" class="form-control sms-text" form="form-module">{{ module_corbit_sms_order_customer_text }}</textarea>
              </div>
            </div>
            <div class="row mb-3">
              <label class="col-sm-2 col-form-label">{{ entry_order_admin }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch mb-2">
                  <input type="hidden" name="module_corbit_sms_order_admin_status" value="0" form="form-module"/>
                  <input type="checkbox" name="module_corbit_sms_order_admin_status" value="1" class="form-check-input" form="form-module"{% if module_corbit_sms_order_admin_status %} checked{% endif %}/>
                </div>
                <textarea name="module_corbit_sms_order_admin_text" rows="3" class="form-control sms-text" form="form-module">{{ module_corbit_sms_order_admin_text }}</textarea>
              </div>
            </div>
            <div class="alert alert-info">{{ text_placeholders }}</div>
          </div>
          <div id="tab-status" class="tab-pane">
            <p class="text-muted">{{ text_status_help }}</p>
            <div class="table-responsive">
              <table class="table table-bordered">
                <thead>
                  <tr>
                    <td style="width: 20%;">{{ column_status }}</td>
                    <td>{{ entry_message }}</td>
                  </tr>
                </thead>
                <tbody>
                  {% for order_status in order_statuses %}
                    {% set current = module_corbit_sms_order_status[order_status.order_status_id] ?? {} %}
                    <tr>
                      <td>
                        <div class="form-check form-switch">
                          <input type="hidden" name="module_corbit_sms_order_status[{{ order_status.order_status_id }}][status]" value="0" form="form-module"/>
                          <input type="checkbox" name="module_corbit_sms_order_status[{{ order_status.order_status_id }}][status]" value="1" id="input-order-status-{{ order_status.order_status_id }}" class="form-check-input" form="form-module"{% if current.status is defined and current.status %} checked{% endif %}/>
                          <label for="input-order-status-{{ order_status.order_status_id }}" class="form-check-label">{{ order_status.name }}</label>
                        </div>
                      </td>
                      <td><textarea name="module_corbit_sms_order_status[{{ order_status.order_status_id }}][text]" rows="2" class="form-control sms-text" form="form-module">{{ current.text ?? '' }}</textarea></td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
            <div class="alert alert-info">{{ text_placeholders }}</div>
          </div>
          <div id="tab-customer" class="tab-pane">
            <div class="row mb-3">
              <label class="col-sm-2 col-form-label">{{ entry_register }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch mb-2">
                  <input type="hidden" name="module_corbit_sms_register_status" value="0" form="form-module"/>
                  <input type="checkbox" name="module_corbit_sms_register_status" value="1" class="form-check-input" form="form-module"{% if module_corbit_sms_register_status %} checked{% endif %}/>
                </div>
                <textarea name="module_corbit_sms_register_text" rows="3" class="form-control sms-text" form="form-module">{{ module_corbit_sms_register_text }}</textarea>
              </div>
            </div>
            <div class="alert alert-info">{{ text_placeholders_customer }}</div>
          </div>
          <div id="tab-otp" class="tab-pane">
            <p class="text-muted">{{ text_otp_help }}</p>
            <div class="row mb-3">
              <label for="input-otp-status" class="col-sm-2 col-form-label">{{ entry_otp_status }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="hidden" name="module_corbit_sms_otp_status" value="0" form="form-module"/>
                  <input type="checkbox" name="module_corbit_sms_otp_status" value="1" id="input-otp-status" class="form-check-input" form="form-module"{% if module_corbit_sms_otp_status %} checked{% endif %}/>
                </div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-otp-text" class="col-sm-2 col-form-label">{{ entry_otp_text }}</label>
              <div class="col-sm-10">
                <textarea name="module_corbit_sms_otp_text" rows="2" id="input-otp-text" class="form-control sms-text" form="form-module">{{ module_corbit_sms_otp_text }}</textarea>
                <div class="form-text">{{ text_otp_placeholders }}</div>
                <div id="error-otp-text" class="invalid-feedback"></div>
              </div>
            </div>
            {% for field in ['length', 'expiry', 'cooldown', 'hourly', 'daily'] %}
              <div class="row mb-3">
                <label for="input-otp-{{ field }}" class="col-sm-2 col-form-label">{{ attribute(_context, 'entry_otp_' ~ field) }}</label>
                <div class="col-sm-10">
                  <input type="number" min="{{ field == 'length' ? 4 : 0 }}"{% if field == 'length' %} max="8"{% endif %} name="module_corbit_sms_otp_{{ field }}" value="{{ attribute(_context, 'module_corbit_sms_otp_' ~ field) }}" id="input-otp-{{ field }}" class="form-control" form="form-module"/>
                  {% if field == 'daily' %}<div class="form-text">{{ help_otp_daily }}</div>{% endif %}
                </div>
              </div>
            {% endfor %}
            <div class="row mb-3">
              <label for="input-otp-countries" class="col-sm-2 col-form-label">{{ entry_otp_countries }}</label>
              <div class="col-sm-10">
                <input type="text" name="module_corbit_sms_otp_countries" value="{{ module_corbit_sms_otp_countries }}" id="input-otp-countries" class="form-control" dir="ltr" form="form-module"/>
                <div class="form-text">{{ help_otp_countries }}</div>
              </div>
            </div>
            <div class="alert alert-info"><i class="fa-solid fa-shield-halved"></i> {{ text_otp_protection }}</div>
          </div>
          <div id="tab-send" class="tab-pane">
            <form id="form-send">
              <div class="row mb-3">
                <label for="input-to" class="col-sm-2 col-form-label">{{ entry_to }}</label>
                <div class="col-sm-10">
                  <select name="to" id="input-to" class="form-select">
                    <option value="custom">{{ text_to_custom }}</option>
                    <option value="all">{{ text_to_all }}</option>
                    <option value="newsletter">{{ text_to_newsletter }}</option>
                    <option value="customer_group">{{ text_to_customer_group }}</option>
                  </select>
                </div>
              </div>
              <div id="send-numbers" class="row mb-3">
                <label for="input-numbers" class="col-sm-2 col-form-label">{{ entry_numbers }}</label>
                <div class="col-sm-10">
                  <textarea name="numbers" rows="4" id="input-numbers" class="form-control" dir="ltr" placeholder="05xxxxxxxx"></textarea>
                  <div class="form-text">{{ help_numbers }}</div>
                </div>
              </div>
              <div id="send-customer-group" class="row mb-3 d-none">
                <label for="input-customer-group" class="col-sm-2 col-form-label">{{ entry_customer_group }}</label>
                <div class="col-sm-10">
                  <select name="customer_group_id" id="input-customer-group" class="form-select">
                    {% for customer_group in customer_groups %}
                      <option value="{{ customer_group.customer_group_id }}">{{ customer_group.name }}</option>
                    {% endfor %}
                  </select>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-message" class="col-sm-2 col-form-label">{{ entry_message }}</label>
                <div class="col-sm-10">
                  <textarea name="message" rows="4" id="input-message" class="form-control sms-text"></textarea>
                </div>
              </div>
              <div class="text-end">
                <button type="button" id="button-send" class="btn btn-primary"><i class="fa-solid fa-paper-plane"></i> {{ button_send }}</button>
              </div>
            </form>
          </div>
          <div id="tab-log" class="tab-pane">
            <div class="text-end mb-2">
              <button type="button" id="button-clear-log" class="btn btn-outline-danger btn-sm"><i class="fa-solid fa-eraser"></i> {{ button_clear }}</button>
            </div>
            <div id="log"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
(function () {
    var alertBox = function (json) {
        if (json['error']) {
            $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
        }

        if (json['success']) {
            $('#alert').prepend('<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> ' + json['success'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
        }
    };

    var post = function (button, url, data, done) {
        $.ajax({
            url: url.replaceAll('&amp;', '&'),
            type: 'post',
            data: data,
            dataType: 'json',
            beforeSend: function () {
                $(button).button('loading');
            },
            complete: function () {
                $(button).button('reset');
            },
            success: function (json) {
                alertBox(json);

                if (done) {
                    done(json);
                }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    };

    var credentials = function () {
        return {
            module_corbit_sms_api_key: $('#input-api-key').val(),
            module_corbit_sms_sender: $('#input-sender').val()
        };
    };

    $('#button-test').on('click', function () {
        var data = credentials();

        data.telephone = $('#input-test-telephone').val();

        post(this, '{{ test }}', data);
    });

    $('#button-balance').on('click', function () {
        post(this, '{{ balance }}', credentials());
    });

    $('#input-to').on('change', function () {
        $('#send-numbers').toggleClass('d-none', this.value != 'custom');
        $('#send-customer-group').toggleClass('d-none', this.value != 'customer_group');
    });

    $('#button-send').on('click', function () {
        if (!confirm('{{ text_confirm_send|escape('js') }}')) {
            return;
        }

        post(this, '{{ send }}', $('#form-send').serialize(), function () {
            $('#log').load('{{ log }}'.replaceAll('&amp;', '&'));
        });
    });

    $('#log').on('click', '.pagination a', function (e) {
        e.preventDefault();

        $('#log').load(this.href);
    });

    $('#button-clear-log').on('click', function () {
        if (!confirm('{{ text_confirm|escape('js') }}')) {
            return;
        }

        post(this, '{{ clear_log }}', {}, function () {
            $('#log').load('{{ log }}'.replaceAll('&amp;', '&'));
        });
    });

    // Live character / SMS part counter (70 chars per part for Arabic, 160 for Latin).
    $('.sms-text').each(function () {
        var counter = $('<div class="form-text text-end"></div>');

        $(this).after(counter);

        var update = function (el) {
            var text = $(el).val();
            var unicode = /[^\u0000-\u007F]/.test(text);
            var single = unicode ? 70 : 160;
            var multi = unicode ? 67 : 153;
            var parts = text.length <= single ? 1 : Math.ceil(text.length / multi);

            counter.text(text.length + ' {{ text_characters }} / ' + parts + ' SMS');
        };

        $(this).on('input', function () {
            update(this);
        });

        update(this);
    });

    $('#log').load('{{ log }}'.replaceAll('&amp;', '&'));
})();
//--></script>
{{ footer }}
