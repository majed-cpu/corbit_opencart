<div id="corbit-otp" class="mt-2">
  {% if not has_telephone %}
    <label for="input-telephone" class="form-label mt-3">{{ entry_telephone }}</label>
    <input type="tel" name="telephone" value="{{ telephone|e }}" placeholder="05xxxxxxxx" id="input-telephone" class="form-control" dir="ltr" autocomplete="tel"/>
    <div id="error-telephone" class="invalid-feedback"></div>
  {% endif %}
  <label for="input-corbit-otp" class="form-label mt-2 small text-muted">{{ text_otp_title }}</label>
  <div class="input-group">
    <input type="text" name="corbit_otp_code" value="" placeholder="{{ entry_otp_code }}" id="input-corbit-otp" class="form-control" inputmode="numeric" autocomplete="one-time-code" maxlength="8" dir="ltr"/>
    <button type="button" id="button-corbit-otp" class="btn btn-outline-secondary">{{ button_otp_send }}</button>
  </div>
  <div id="corbit-otp-message" class="form-text text-success"></div>
  <div id="error-corbit-otp" class="invalid-feedback"></div>
</div>
<script type="text/javascript"><!--
(function ($) {
    var button = $('#button-corbit-otp');
    var timer = null;

    var countdown = function (seconds) {
        clearInterval(timer);

        var tick = function () {
            if (seconds <= 0) {
                clearInterval(timer);

                button.prop('disabled', false).text({{ button_otp_resend|json_encode }});

                return;
            }

            button.prop('disabled', true).text({{ text_otp_resend|json_encode }}.replace('%s', seconds));

            seconds--;
        };

        tick();

        timer = setInterval(tick, 1000);
    };

    button.on('click', function () {
        var form = button.closest('form');
        var telephone = (form.length ? form : $(document)).find('input[name="telephone"]').first().val();

        $.ajax({
            url: {{ send_url|json_encode }},
            type: 'post',
            data: {telephone: telephone},
            dataType: 'json',
            beforeSend: function () {
                button.prop('disabled', true);
                $('#error-corbit-otp').removeClass('d-block').text('');
                $('#corbit-otp-message').text('');
            },
            success: function (json) {
                if (json['error']) {
                    $('#error-corbit-otp').text(json['error']).addClass('d-block');
                }

                if (json['success']) {
                    $('#corbit-otp-message').text(json['success']);
                    $('#input-corbit-otp').val('').trigger('focus');
                }

                if (json['wait']) {
                    countdown(json['wait']);
                } else {
                    button.prop('disabled', false);
                }
            },
            error: function () {
                button.prop('disabled', false);
            }
        });
    });
})(jQuery);
//--></script>
