{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    <div id="corbit-alert">
      {% if error_warning %}
        <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      {% endif %}
      {% if success %}
        <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      {% endif %}
      {% if ocmod_missing %}
        <div class="alert alert-warning"><i class="fa fa-exclamation-triangle"></i> {{ text_otp_ocmod }}</div>
      {% endif %}
    </div>
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <p class="text-muted">{{ text_intro }}</p>
        <ul class="nav nav-tabs">
          <li class="active"><a href="#tab-general" data-toggle="tab">{{ text_tab_general }}</a></li>
          <li><a href="#tab-order" data-toggle="tab">{{ text_tab_order }}</a></li>
          <li><a href="#tab-status" data-toggle="tab">{{ text_tab_status }}</a></li>
          <li><a href="#tab-customer" data-toggle="tab">{{ text_tab_customer }}</a></li>
          <li><a href="#tab-otp" data-toggle="tab">{{ text_tab_otp }}</a></li>
          <li><a href="#tab-send" data-toggle="tab">{{ text_tab_send }}</a></li>
          <li><a href="#tab-log" data-toggle="tab">{{ text_tab_log }}</a></li>
        </ul>
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal"></form>
        <div class="tab-content form-horizontal">
          <div class="tab-pane active" id="tab-general">
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
              <div class="col-sm-10">
                <select name="module_corbit_sms_status" id="input-status" class="form-control" form="form-module">
                  <option value="1"{% if module_corbit_sms_status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                  <option value="0"{% if not module_corbit_sms_status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
                </select>
              </div>
            </div>
            <div class="form-group required{% if error_api_key %} has-error{% endif %}">
              <label class="col-sm-2 control-label" for="input-api-key">{{ entry_api_key }}</label>
              <div class="col-sm-10">
                <input type="password" name="module_corbit_sms_api_key" value="{{ module_corbit_sms_api_key }}" placeholder="{{ entry_api_key }}" id="input-api-key" class="form-control" autocomplete="off" form="form-module"/>
                {% if error_api_key %}<div class="text-danger">{{ error_api_key }}</div>{% endif %}
              </div>
            </div>
            <div class="form-group required{% if error_sender %} has-error{% endif %}">
              <label class="col-sm-2 control-label" for="input-sender"><span data-toggle="tooltip" title="{{ help_sender }}">{{ entry_sender }}</span></label>
              <div class="col-sm-10">
                <input type="text" name="module_corbit_sms_sender" value="{{ module_corbit_sms_sender }}" placeholder="{{ entry_sender }}" id="input-sender" class="form-control" form="form-module"/>
                {% if error_sender %}<div class="text-danger">{{ error_sender }}</div>{% endif %}
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-admin-telephone"><span data-toggle="tooltip" title="{{ help_admin_telephone }}">{{ entry_admin_telephone }}</span></label>
              <div class="col-sm-10">
                <input type="text" name="module_corbit_sms_admin_telephone" value="{{ module_corbit_sms_admin_telephone }}" placeholder="05xxxxxxxx" id="input-admin-telephone" class="form-control" dir="ltr" form="form-module"/>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-test-telephone">{{ entry_test_telephone }}</label>
              <div class="col-sm-10">
                <div class="input-group">
                  <input type="text" value="" placeholder="05xxxxxxxx" id="input-test-telephone" class="form-control" dir="ltr"/>
                  <span class="input-group-btn">
                    <button type="button" id="button-test" data-loading-text="{{ text_loading }}" class="btn btn-primary"><i class="fa fa-paper-plane"></i> {{ button_test }}</button>
                    <button type="button" id="button-balance" data-loading-text="{{ text_loading }}" class="btn btn-default"><i class="fa fa-money"></i> {{ button_balance }}</button>
                  </span>
                </div>
              </div>
            </div>
          </div>
          <div class="tab-pane" id="tab-order">
            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_order_customer }}</label>
              <div class="col-sm-10">
                <div class="checkbox"><label>
                  <input type="hidden" name="module_corbit_sms_order_customer_status" value="0" form="form-module"/>
                  <input type="checkbox" name="module_corbit_sms_order_customer_status" value="1" form="form-module"{% if module_corbit_sms_order_customer_status %} checked="checked"{% endif %}/> {{ text_enabled }}
                </label></div>
                <textarea name="module_corbit_sms_order_customer_text" rows="3" class="form-control sms-text" form="form-module">{{ module_corbit_sms_order_customer_text }}</textarea>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_order_admin }}</label>
              <div class="col-sm-10">
                <div class="checkbox"><label>
                  <input type="hidden" name="module_corbit_sms_order_admin_status" value="0" form="form-module"/>
                  <input type="checkbox" name="module_corbit_sms_order_admin_status" value="1" form="form-module"{% if module_corbit_sms_order_admin_status %} checked="checked"{% endif %}/> {{ text_enabled }}
                </label></div>
                <textarea name="module_corbit_sms_order_admin_text" rows="3" class="form-control sms-text" form="form-module">{{ module_corbit_sms_order_admin_text }}</textarea>
              </div>
            </div>
            <div class="alert alert-info">{{ text_placeholders }}</div>
          </div>
          <div class="tab-pane" id="tab-status">
            <p class="text-muted">{{ text_status_help }}</p>
            <div class="table-responsive">
              <table class="table table-bordered">
                <thead>
                  <tr>
                    <td style="width: 20%;">{{ column_status }}</td>
                    <td>{{ entry_message }}</td>
                  </tr>
                </thead>
                <tbody>
                  {% for order_status in order_statuses %}
                    <tr>
                      <td>
                        <div class="checkbox"><label>
                          <input type="hidden" name="module_corbit_sms_order_status[{{ order_status.order_status_id }}][status]" value="0" form="form-module"/>
                          <input type="checkbox" name="module_corbit_sms_order_status[{{ order_status.order_status_id }}][status]" value="1" form="form-module"{% if order_status.status %} checked="checked"{% endif %}/> {{ order_status.name }}
                        </label></div>
                      </td>
                      <td><textarea name="module_corbit_sms_order_status[{{ order_status.order_status_id }}][text]" rows="2" class="form-control sms-text" form="form-module">{{ order_status.text }}</textarea></td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
            <div class="alert alert-info">{{ text_placeholders }}</div>
          </div>
          <div class="tab-pane" id="tab-customer">
            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_register }}</label>
              <div class="col-sm-10">
                <div class="checkbox"><label>
                  <input type="hidden" name="module_corbit_sms_register_status" value="0" form="form-module"/>
                  <input type="checkbox" name="module_corbit_sms_register_status" value="1" form="form-module"{% if module_corbit_sms_register_status %} checked="checked"{% endif %}/> {{ text_enabled }}
                </label></div>
                <textarea name="module_corbit_sms_register_text" rows="3" class="form-control sms-text" form="form-module">{{ module_corbit_sms_register_text }}</textarea>
              </div>
            </div>
            <div class="alert alert-info">{{ text_placeholders_customer }}</div>
          </div>
          <div class="tab-pane" id="tab-otp">
            <p class="text-muted">{{ text_otp_help }}</p>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-otp-status">{{ entry_otp_status }}</label>
              <div class="col-sm-10">
                <select name="module_corbit_sms_otp_status" id="input-otp-status" class="form-control" form="form-module">
                  <option value="1"{% if module_corbit_sms_otp_status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                  <option value="0"{% if not module_corbit_sms_otp_status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
                </select>
              </div>
            </div>
            <div class="form-group{% if error_otp_text %} has-error{% endif %}">
              <label class="col-sm-2 control-label" for="input-otp-text">{{ entry_otp_text }}</label>
              <div class="col-sm-10">
                <textarea name="module_corbit_sms_otp_text" rows="2" id="input-otp-text" class="form-control sms-text" form="form-module">{{ module_corbit_sms_otp_text }}</textarea>
                <div class="help-block">{{ text_otp_placeholders }}</div>
                {% if error_otp_text %}<div class="text-danger">{{ error_otp_text }}</div>{% endif %}
              </div>
            </div>
            {% for field in otp_fields %}
              <div class="form-group">
                <label class="col-sm-2 control-label" for="{{ field.id }}">{{ field.label }}</label>
                <div class="col-sm-10">
                  <input type="number" min="{{ field.min }}"{% if field.max %} max="{{ field.max }}"{% endif %} name="{{ field.name }}" value="{{ field.value }}" id="{{ field.id }}" class="form-control" form="form-module"/>
                  {% if field.help %}<div class="help-block">{{ field.help }}</div>{% endif %}
                </div>
              </div>
            {% endfor %}
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-otp-countries"><span data-toggle="tooltip" title="{{ help_otp_countries }}">{{ entry_otp_countries }}</span></label>
              <div class="col-sm-10">
                <input type="text" name="module_corbit_sms_otp_countries" value="{{ module_corbit_sms_otp_countries }}" id="input-otp-countries" class="form-control" dir="ltr" form="form-module"/>
              </div>
            </div>
            <div class="alert alert-info"><i class="fa fa-shield"></i> {{ text_otp_protection }}</div>
          </div>
          <div class="tab-pane" id="tab-send">
            <div id="form-send">
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-to">{{ entry_to }}</label>
                <div class="col-sm-10">
                  <select name="to" id="input-to" class="form-control">
                    <option value="custom">{{ text_to_custom }}</option>
                    <option value="all">{{ text_to_all }}</option>
                    <option value="newsletter">{{ text_to_newsletter }}</option>
                    <option value="customer_group">{{ text_to_customer_group }}</option>
                  </select>
                </div>
              </div>
              <div id="send-numbers" class="form-group">
                <label class="col-sm-2 control-label" for="input-numbers"><span data-toggle="tooltip" title="{{ help_numbers }}">{{ entry_numbers }}</span></label>
                <div class="col-sm-10">
                  <textarea name="numbers" rows="4" id="input-numbers" class="form-control" dir="ltr" placeholder="05xxxxxxxx"></textarea>
                </div>
              </div>
              <div id="send-customer-group" class="form-group hidden">
                <label class="col-sm-2 control-label" for="input-customer-group">{{ entry_customer_group }}</label>
                <div class="col-sm-10">
                  <select name="customer_group_id" id="input-customer-group" class="form-control">
                    {% for customer_group in customer_groups %}
                      <option value="{{ customer_group.customer_group_id }}">{{ customer_group.name }}</option>
                    {% endfor %}
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-message">{{ entry_message }}</label>
                <div class="col-sm-10">
                  <textarea name="message" rows="4" id="input-message" class="form-control sms-text"></textarea>
                </div>
              </div>
              <div class="text-right">
                <button type="button" id="button-send" data-loading-text="{{ text_loading }}" class="btn btn-primary"><i class="fa fa-paper-plane"></i> {{ button_send }}</button>
              </div>
            </div>
          </div>
          <div class="tab-pane" id="tab-log">
            <div class="text-right" style="margin-bottom: 10px;">
              <button type="button" id="button-clear-log" data-loading-text="{{ text_loading }}" class="btn btn-danger btn-sm"><i class="fa fa-eraser"></i> {{ button_clear }}</button>
            </div>
            <div id="log"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
(function ($) {
    var logUrl = {{ log|replace({'&amp;': '&'})|json_encode }};

    var alertBox = function (json) {
        $('#corbit-alert .alert-dismissible').remove();

        if (json['error']) {
            $('#corbit-alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
        }

        if (json['success']) {
            $('#corbit-alert').prepend('<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> ' + json['success'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
        }
    };

    var post = function (button, url, data, done) {
        $.ajax({
            url: url.replace(/&amp;/g, '&'),
            type: 'post',
            data: data,
            dataType: 'json',
            beforeSend: function () {
                $(button).button('loading');
            },
            complete: function () {
                $(button).button('reset');
            },
            success: function (json) {
                alertBox(json);

                if (done) {
                    done(json);
                }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    };

    var credentials = function () {
        return {
            module_corbit_sms_api_key: $('#input-api-key').val(),
            module_corbit_sms_sender: $('#input-sender').val()
        };
    };

    $('#button-test').on('click', function () {
        var data = credentials();

        data.telephone = $('#input-test-telephone').val();

        post(this, '{{ test }}', data);
    });

    $('#button-balance').on('click', function () {
        post(this, '{{ balance }}', credentials());
    });

    $('#input-to').on('change', function () {
        $('#send-numbers').toggleClass('hidden', this.value != 'custom');
        $('#send-customer-group').toggleClass('hidden', this.value != 'customer_group');
    });

    $('#button-send').on('click', function () {
        if (!confirm({{ text_confirm_send|json_encode }})) {
            return;
        }

        post(this, '{{ send }}', $('#form-send :input').serialize(), function () {
            $('#log').load(logUrl);
        });
    });

    $('#log').on('click', '.pagination a', function (e) {
        e.preventDefault();

        $('#log').load(this.href);
    });

    $('#button-clear-log').on('click', function () {
        if (!confirm({{ text_confirm|json_encode }})) {
            return;
        }

        post(this, '{{ clear_log }}', {}, function () {
            $('#log').load(logUrl);
        });
    });

    // Live character / SMS part counter (70 chars per part for Arabic, 160 for Latin).
    $('.sms-text').each(function () {
        var counter = $('<div class="help-block text-right"></div>');

        $(this).after(counter);

        var update = function (el) {
            var text = $(el).val();
            var unicode = /[^\u0000-\u007F]/.test(text);
            var single = unicode ? 70 : 160;
            var multi = unicode ? 67 : 153;
            var parts = text.length <= single ? 1 : Math.ceil(text.length / multi);

            counter.text(text.length + ' {{ text_characters }} / ' + parts + ' SMS');
        };

        $(this).on('input', function () {
            update(this);
        });

        update(this);
    });

    $('#log').load(logUrl);
})(jQuery);
//--></script>
{{ footer }}
